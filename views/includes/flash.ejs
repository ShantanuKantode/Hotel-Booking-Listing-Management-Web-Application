 <% if(success && success.length){ %>

<div class="alert alert-success flash-message fade show" role="alert">

    <div class="flash-content">
        <i class="fa-solid fa-circle-check"></i>
        <span><%= success %></span>
    </div>

    <button
        type="button"
        class="btn-close"
        data-bs-dismiss="alert"
        aria-label="Close">
    </button>

</div>

<% } %>


<% if(error && error.length){ %>

<div class="alert alert-danger flash-message fade show" role="alert">

    <div class="flash-content">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span><%= error %></span>
    </div>

    <button
        type="button"
        class="btn-close"
        data-bs-dismiss="alert"
        aria-label="Close">
    </button>

</div>

<% } %>