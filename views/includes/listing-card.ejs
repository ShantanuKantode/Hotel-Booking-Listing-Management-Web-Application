<% const isFavorite = favoriteIds.has(listing._id.toString()); %>
<% const isGuestFavorite = listing.reviewCount >= 5 && listing.averageRating >= 4.5; %>
<div class="col">
  <div class="hotel-card">
    <div class="hotel-image-wrapper">
      <a href="/listings/<%= listing._id %>" class="listing-link">
        <img src="<%= listing.image.url %>" class="hotel-image" alt="<%= listing.title %> ">
        <% if (isGuestFavorite) { %>
          <div class="hotel-badge"><i class="fa-solid fa-star" aria-hidden="true"></i> Guest favorite</div>
        <% } %>
        <div class="image-dots"><span class="active"></span><span></span><span></span><span></span></div>
      </a>
      <button
        class="favorite-btn <%= isFavorite ? "is-favorite" : "" %>"
        type="button"
        data-favorite-button
        data-listing-id="<%= listing._id %>"
        data-favorited="<%= isFavorite %>"
        aria-label="<%= isFavorite ? "Remove " + listing.title + " from favorites" : "Save " + listing.title + " to favorites" %>"
        aria-pressed="<%= isFavorite %>"
      >
        <i class="fa-<%= isFavorite ? "solid" : "regular" %> fa-heart"></i>
      </button>
    </div>

    <a href="/listings/<%= listing._id %>" class="listing-link hotel-card-link">
      <div class="hotel-card-body">
        <div class="hotel-title-row">
          <h3><%= listing.title %></h3>
          <% if (listing.reviewCount) { %>
            <div class="hotel-rating" aria-label="Rated <%= listing.averageRating.toFixed(1) %> out of 5 from <%= listing.reviewCount %> reviews">
              <i class="fa-solid fa-star" aria-hidden="true"></i>
              <span><%= listing.averageRating.toFixed(1) %></span>
              <small>(<%= listing.reviewCount %>)</small>
            </div>
          <% } else { %>
            <div class="hotel-rating hotel-rating-new" aria-label="No reviews yet">New</div>
          <% } %>
        </div>
        <div class="hotel-location"><i class="fa-solid fa-location-dot"></i><span><%= listing.location %></span></div>
        <div class="hotel-bottom">
          <!-- <div class="hotel-price"><strong>&#8377;<%= listing.price.toLocaleString("en-IN") %></strong><span>/ night</span></div> -->
           <div
  class="hotel-price"
  data-price-container
  data-base-price="<%= listing.price %>"
>

  <div class="hotel-price-main">

    <strong data-price>
      &#8377;<%= listing.price.toLocaleString("en-IN") %>
    </strong>

    <span>/ night</span>

  </div>

  <small
    class="gst-info"
    data-gst-info
    aria-live="polite"
  ></small>

</div>
          <div class="listing-arrow"><i class="fa-solid fa-arrow-right"></i></div>
        </div>
      </div>
    </a>
  </div>
</div>
