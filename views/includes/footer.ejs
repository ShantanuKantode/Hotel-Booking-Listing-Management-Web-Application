<footer class="hz-footer">

    <div class="hz-footer-container">



        <div class="hz-footer-cta">

            <div class="hz-footer-cta-content">

                <span class="hz-footer-eyebrow">
                    Grow with Horizone
                </span>

                <h2>
                    Share places.<br>
                    Earn with Horizone.
                </h2>

                <p>
                    Recommend amazing stays to your audience
                    and earn when travelers book through your link.
                </p>

                <a href="/listings/new" class="hz-footer-cta-button">
                    <span>Become a host</span>
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                </a>

            </div>


            <!-- Decorative visual -->
            <div class="hz-footer-cta-visual">

                <div class="hz-footer-orbit orbit-one"></div>

                <div class="hz-footer-orbit orbit-two"></div>

                <div class="hz-footer-orbit orbit-three"></div>

                <div class="hz-footer-center">
                    <img
                        src="/images/logo.png"
                        alt="Horizone"
                    >
                </div>

                <div class="hz-footer-dot footer-dot-one">
                    <i class="fa-solid fa-location-dot"></i>
                </div>

                <div class="hz-footer-dot footer-dot-two">
                    <i class="fa-solid fa-house"></i>
                </div>

                <div class="hz-footer-dot footer-dot-three">
                    <i class="fa-solid fa-plane"></i>
                </div>

            </div>

        </div>



        <div class="hz-footer-main">


            <!-- Brand -->
            <div class="hz-footer-brand">

                <a href="/listings" class="hz-footer-logo">

                    <div class="hz-footer-logo-icon">
                        <img
                            src="/images/logo.png"
                            alt="Horizone Logo"
                        >
                    </div>

                    <span>Horizone</span>

                </a>

                <p>
                    Discover unique stays, beautiful places,
                    and unforgettable experiences.
                </p>


                <!-- Social Media -->
                <div class="hz-footer-social">

                    <a
                        href="#"
                        aria-label="Facebook"
                        title="Facebook"
                    >
                        <i class="fa-brands fa-facebook-f"></i>
                    </a>

                    <a
                        href="#"
                        aria-label="Instagram"
                        title="Instagram"
                    >
                        <i class="fa-brands fa-instagram"></i>
                    </a>

                    <a
                        href="#"
                        aria-label="LinkedIn"
                        title="LinkedIn"
                    >
                        <i class="fa-brands fa-linkedin-in"></i>
                    </a>

                    <a
                        href="#"
                        aria-label="Twitter"
                        title="Twitter"
                    >
                        <i class="fa-brands fa-x-twitter"></i>
                    </a>

                </div>

            </div>


            <!-- Company -->
            <div class="hz-footer-column">

                <h3>Company</h3>

                <a href="/listings">
                    Explore
                </a>

                <a href="/listings/new">
                    Add your place
                </a>

                <a href="/about">
                    About us
                </a>

                <a href="/contact">
                    Contact us
                </a>

            </div>


            <!-- Discover -->
            <div class="hz-footer-column">

                <h3>Discover</h3>

                <a href="/listings">
                    Popular stays
                </a>

                <a href="/listings">
                    Unique places
                </a>

                <a href="/favorites">
                    Favorites
                </a>

                <a href="/listings">
                    Destinations
                </a>

            </div>


            <!-- Support -->
            <div class="hz-footer-column">

                <h3>Support</h3>

                <a href="/help">
                    Help Center
                </a>

                <a href="/privacy">
                    Privacy
                </a>

                <a href="/terms">
                    Terms
                </a>

                <a href="/contact">
                    Support
                </a>

            </div>


            <!-- Newsletter -->
            <div class="hz-footer-newsletter">

                <h3>
                    Stay in the loop
                </h3>

                <p>
                    Get travel inspiration, new destinations,
                    and exclusive updates.
                </p>


                <form
                    action="#"
                    method="POST"
                    class="hz-newsletter-form"
                >

                    <div class="hz-newsletter-input">

                        <i class="fa-regular fa-envelope"></i>

                        <input
                            type="email"
                            name="email"
                            placeholder="Enter your email"
                            aria-label="Email address"
                            required
                        >

                    </div>

                    <button
                        type="submit"
                        aria-label="Subscribe"
                    >
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>

                </form>

            </div>

        </div>



        <div class="hz-footer-bottom">

            <div class="hz-footer-copyright">

                © <%= new Date().getFullYear() %>
                Horizone. All rights reserved.

            </div>


            <div class="hz-footer-bottom-links">

                <a href="/privacy">
                    Privacy
                </a>

                <a href="/terms">
                    Terms
                </a>

                <a href="/contact">
                    Contact
                </a>

            </div>


            <div class="hz-footer-made">

                Made with
                <i class="fa-regular fa-heart"></i>
                for travelers

            </div>

        </div>

    </div>

</footer>