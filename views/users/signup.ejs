<% layout("layouts/boilerplate") %>

<div class="hz-auth-page">

    <div class="hz-auth-card">

        <!-- Horizone Logo -->
        <div class="hz-auth-brand">
            <a href="/listings">

                <div class="hz-auth-logo">
                    <img
                        src="/images/logo.png"
                        alt="Horizone Logo"
                    >
                </div>

                <span>Horizone</span>

            </a>
        </div>


        <!-- Heading -->
        <div class="hz-auth-header">

            <h1>Create an account</h1>

            <p>
                Join Horizone and discover amazing places.
            </p>

        </div>


        <!-- Signup Form -->
        <form
            action="/signup"
            method="POST"
            novalidate
            class="needs-validation hz-auth-form"
        >

            <!-- Username -->
            <div class="hz-input-group">

                <label for="username">
                    Username
                </label>

                <div class="hz-input-wrapper">

                    <i class="fa-regular fa-user"></i>

                    <input
                        name="username"
                        type="text"
                        id="username"
                        placeholder="Choose a username"
                        autocomplete="username"
                        required
                    >

                </div>

                <div class="valid-feedback">
                    Looks good!
                </div>

                <div class="invalid-feedback">
                    Enter username
                </div>

            </div>


            <!-- Email -->
            <div class="hz-input-group">

                <label for="email">
                    Email
                </label>

                <div class="hz-input-wrapper">

                    <i class="fa-regular fa-envelope"></i>

                    <input
                        name="email"
                        type="email"
                        id="email"
                        placeholder="Enter your email"
                        autocomplete="email"
                        required
                    >

                </div>

                <div class="valid-feedback">
                    Looks good!
                </div>

                <div class="invalid-feedback">
                    Enter a valid email
                </div>

            </div>


            <!-- Password -->
            <div class="hz-input-group">

                <label for="password">
                    Password
                </label>

                <div class="hz-input-wrapper">

                    <i class="fa-solid fa-lock"></i>

                    <input
                        name="password"
                        type="password"
                        id="password"
                        placeholder="Create a password"
                        autocomplete="new-password"
                        required
                    >

                    <!-- Show password -->
                    <button
                        type="button"
                        class="hz-password-toggle"
                        id="passwordToggle"
                        aria-label="Show password"
                    >
                        <i class="fa-regular fa-eye"></i>
                    </button>

                </div>

                <div class="valid-feedback">
                    Looks good!
                </div>

                <div class="invalid-feedback">
                    Enter password
                </div>

            </div>


            <!-- Create Account -->
            <button
                type="submit"
                class="hz-login-button"
            >

                <span>Create account</span>

                <i class="fa-solid fa-arrow-right"></i>

            </button>

        </form>


        <!-- Divider -->
        <div class="hz-auth-divider">

            <span>
                Already a member?
            </span>

        </div>


        <!-- Login -->
        <a
            href="/login"
            class="hz-create-account"
        >
            Log in to your account
        </a>


        <!-- Footer -->
        <p class="hz-auth-footer">
            By creating an account, you agree to our
            terms and privacy policy.
        </p>

    </div>

</div>


<!-- Password Toggle -->
<script>

    const passwordInput =
        document.getElementById("password");

    const passwordToggle =
        document.getElementById("passwordToggle");


    if (passwordToggle && passwordInput) {

        passwordToggle.addEventListener(
            "click",
            function () {

                const isPassword =
                    passwordInput.type === "password";


                passwordInput.type =
                    isPassword
                        ? "text"
                        : "password";


                this.innerHTML = isPassword
                    ? '<i class="fa-regular fa-eye-slash"></i>'
                    : '<i class="fa-regular fa-eye"></i>';

            }
        );

    }

</script>