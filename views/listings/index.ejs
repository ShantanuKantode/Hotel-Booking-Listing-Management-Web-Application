<% layout("/layouts/boilerplate") %> 


<body>
<div class="category-section">

  <div class="category-scroll">
    <a href="/listings" class="category-item <%= !selectedCategory ? "active" : "" %>">
      <i class="fa-solid fa-house"></i><span>All</span>
    </a>
    <a href="/listings?category=Mountain" class="category-item <%= selectedCategory === "Mountain" ? "active" : "" %>">
      <i class="fa-solid fa-mountain"></i><span>Mountain</span>
    </a>
    <a href="/listings?category=Beach" class="category-item <%= selectedCategory === "Beach" ? "active" : "" %>">
      <i class="fa-solid fa-umbrella-beach"></i><span>Beach</span>
    </a>
    <a href="/listings?category=Lakefront" class="category-item <%= selectedCategory === "Lakefront" ? "active" : "" %>">
      <i class="fa-solid fa-water"></i><span>Lakefront</span>
    </a>
    <a href="/listings?category=Farms" class="category-item <%= selectedCategory === "Farms" ? "active" : "" %>">
      <i class="fa-solid fa-wheat-awn"></i><span>Farms</span>
    </a>
    <a href="/listings?category=Amazing%20Pools" class="category-item <%= selectedCategory === "Amazing Pools" ? "active" : "" %>">
      <i class="fa-solid fa-person-swimming"></i><span>Amazing Pools</span>
    </a>
    <a href="/listings?category=Cabins" class="category-item <%= selectedCategory === "Cabins" ? "active" : "" %>">
      <i class="fa-solid fa-house-chimney"></i><span>Cabins</span>
    </a>
    <a href="/listings?category=Rooms" class="category-item <%= selectedCategory === "Rooms" ? "active" : "" %>">
      <i class="fa-solid fa-bed"></i><span>Rooms</span>
    </a>
    <a href="/listings?category=Hotels" class="category-item <%= selectedCategory === "Hotels" ? "active" : "" %>">
      <i class="fa-solid fa-hotel"></i><span>Hotels</span>
    </a>

  </div>

  <div class="category-controls">

    <details class="category-filter-menu">
      <summary class="filter-btn">
        <i class="fa-solid fa-sliders"></i>
        <span>Filters</span>
      </summary>
      <div class="category-filter-dropdown">
        <p>Browse categories</p>
        <a href="/listings" class="<%= !selectedCategory ? "active" : "" %>">All stays</a>
        <a href="/listings?category=Mountain" class="<%= selectedCategory === "Mountain" ? "active" : "" %>">Mountain</a>
        <a href="/listings?category=Beach" class="<%= selectedCategory === "Beach" ? "active" : "" %>">Beach</a>
        <a href="/listings?category=Lakefront" class="<%= selectedCategory === "Lakefront" ? "active" : "" %>">Lakefront</a>
        <a href="/listings?category=Farms" class="<%= selectedCategory === "Farms" ? "active" : "" %>">Farms</a>
        <a href="/listings?category=Amazing%20Pools" class="<%= selectedCategory === "Amazing Pools" ? "active" : "" %>">Amazing Pools</a>
        <a href="/listings?category=Cabins" class="<%= selectedCategory === "Cabins" ? "active" : "" %>">Cabins</a>
        <a href="/listings?category=Rooms" class="<%= selectedCategory === "Rooms" ? "active" : "" %>">Rooms</a>
        <a href="/listings?category=Hotels" class="<%= selectedCategory === "Hotels" ? "active" : "" %>">Hotels</a>
      </div>
    </details>

    <div class="tax-toggle">

  <span>Include 18% GST</span>

  <label class="switch">
    <input
      type="checkbox"
      id="gstToggle"
      aria-label="Include 18% GST"
    >
    <span class="slider"></span>
  </label>

</div>

  </div>

</div>
<div class="listing">
<!-- Carousel -->
 <div id="hotelCarousel" class="carousel slide hotel-carousel" data-bs-ride="carousel">

  <div class="carousel-indicators">
    <button type="button" data-bs-target="#hotelCarousel" data-bs-slide-to="0" class="active"></button>
    <button type="button" data-bs-target="#hotelCarousel" data-bs-slide-to="1"></button>
    <button type="button" data-bs-target="#hotelCarousel" data-bs-slide-to="2"></button>
  </div>

  <div class="carousel-inner">

    <div class="carousel-item active">
      <img
        src="https://images.unsplash.com/photo-1663998468593-1f104e7c9213?w=1600&auto=format&fit=crop&q=85"
        class="d-block w-100"
        alt="Luxury hotel"
      >

      <div class="carousel-caption">
        <span>
          <i class="fa-solid fa-star"></i>
          Premium stays
        </span>

        <h2>Stay somewhere unforgettable</h2>

        <p>
          Discover beautiful places designed for memorable experiences.
        </p>

        <a href="#listings" class="hero-btn">
          Explore stays
          <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
    </div>


    <div class="carousel-item">
      <img
        src="https://images.unsplash.com/photo-1596436889106-be35e843f974?w=1600&auto=format&fit=crop&q=85"
        class="d-block w-100"
        alt="Beautiful hotel room"
      >

      <div class="carousel-caption">
        <span>
          <i class="fa-solid fa-bed"></i>
          Comfortable rooms
        </span>

        <h2>Your comfort comes first</h2>

        <p>
          Find stylish rooms and relaxing spaces for your perfect getaway.
        </p>

        <a href="#listings" class="hero-btn">
          View rooms
          <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
    </div>


    <div class="carousel-item">
      <img
        src="https://images.unsplash.com/photo-1551882547-ff40c63fe5fa?w=1600&auto=format&fit=crop&q=85"
        class="d-block w-100"
        alt="Luxury hotel"
      >

      <div class="carousel-caption">
        <span>
          <i class="fa-solid fa-location-dot"></i>
          Explore destinations
        </span>

        <h2>Find your next escape</h2>

        <p>
          From peaceful retreats to vibrant cities, discover your next stay.
        </p>

        <a href="#listings" class="hero-btn">
          Discover now
          <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
    </div>

  </div>


  <button
    class="carousel-control-prev"
    type="button"
    data-bs-target="#hotelCarousel"
    data-bs-slide="prev"
  >
    <span class="carousel-control-prev-icon"></span>
    <span class="visually-hidden">Previous</span>
  </button>


  <button
    class="carousel-control-next"
    type="button"
    data-bs-target="#hotelCarousel"
    data-bs-slide="next"
  >
    <span class="carousel-control-next-icon"></span>
    <span class="visually-hidden">Next</span>
  </button>

</div>


<!-- <form method="GET" action="/listings/new">
  <h4>Create New Listing  <button>  New </button></h4>
</form> -->



<div class="listing-header">
  <div>
    <h2>Explore stays</h2>
    <p>Discover amazing places, unique stays and unforgettable experiences.</p>
  </div>

  <div class="listing-count">
    <%= allListing.length %> stays
  </div>
</div>


<% if (allListing.length) { %>
<div id="listings" class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">

  <% for (let listing of allListing) { %>
    <%- include("../includes/listing-card.ejs", { listing, favoriteIds }) %>

  <% } %>

</div>
<% } else { %>
  <div class="empty-listings">
    <i class="fa-solid fa-compass"></i>
    <h3>No <%= selectedCategory %> stays found</h3>
    <p>Try another category or explore all stays.</p>
    <a href="/listings" class="btn empty-listings-btn">View all stays</a>
  </div>
<% } %>



