<% layout("layouts/boilerplate") %>
<script>
   window.mapToken = "<%= process.env.MAP_TOKEN %>"
</script>

<div class="row">
   <div class="col-8 offset-2">
   <h1><%= listing.title %></h1>
   </div>
<div class="card col-6 offset-2 mt-3 card listing-card shadow-sm border-0">

   <img src="<%= listing.image.url  %>" class="card-img-top show-image" alt="listing.image">
   <div class="card-body">
   <p class="card-text"> 
      <h5> <b>Owner:</b>  <%= listing.owner?.username || "Unknown" %> </h5>
      <%= listing.description %> <br>
      <!-- &#8377; <%= listing.price.toLocaleString("en-IN") %>  -->
       <div
  class="hotel-price"
  data-price-container
  data-base-price="<%= listing.price %>"
>

  <div class="hotel-price-main">

    <strong data-price>
      &#8377;<%= listing.price.toLocaleString("en-IN") %>
    </strong>

    <span>/ night</span>

  </div>

  <small
    class="gst-info"
    data-gst-info
    aria-live="polite"
    hidden
  ></small>

</div>

      <br>
      <%= listing.location %> <br>
      <%= listing.country %> <br>
   </p> 
</div>
</div>

<br/>
<% const isFavorite = favoriteIds.has(listing._id.toString()); %>
<button
   class="favorite-detail-btn <%= isFavorite ? "is-favorite" : "" %> offset-2"
   type="button"
   data-favorite-button
   data-listing-id="<%= listing._id %>"
   data-favorited="<%= isFavorite %>"
   aria-label="<%= isFavorite ? "Remove this listing from favorites" : "Save this listing to favorites" %>"
   aria-pressed="<%= isFavorite %>"
>
   <i class="fa-<%= isFavorite ? "solid" : "regular" %> fa-heart"></i>
   <span><%= isFavorite ? "Saved to favorites" : "Save to favorites" %></span>
</button>
<br/>
<section class="rating-summary col-8 offset-2" aria-label="Listing rating summary">
   <% if (ratingSummary.reviewCount) { %>
      <div class="rating-summary-header">
         <div class="rating-stars" aria-label="Rated <%= ratingSummary.averageRating.toFixed(1) %> out of 5">
            <% for (let star = 1; star <= 5; star++) { %>
               <i class="fa-<%= star <= Math.round(ratingSummary.averageRating) ? "solid" : "regular" %> fa-star" aria-hidden="true"></i>
            <% } %>
            <span class="rating-count"><%= ratingSummary.reviewCount %> <%= ratingSummary.reviewCount === 1 ? "review" : "reviews" %></span>
         </div>
      </div>
   <% } else { %>
      <div class="rating-empty-state">
         <i class="fa-solid fa-star" aria-hidden="true"></i>
         <div><strong>New</strong><span>No reviews yet. Be the first to share your experience.</span></div>
      </div>
   <% } %>
</section>
<% if(currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>
<div class="btns">
   <a href="/listings/<%= listing._id %>/edit" class="btn btn-light offset-2  col-1 edit-btn"> Edit </a>
   <form method="POST"action="/listings/<%= listing._id %>?_method=Delete">
      <button class="btn btn-dark offset-4 delete-btn " >Delete</button>
   </form>
</div>
<% } %>
<br>

<div class="col-8 offset-2 mb-3 mt-2">
   <% if (currUser && canReview) { %>
   <h3>Leave Review</h3>
   <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
      <!-- <div class="mb-3 mt-3">
         <label for="rating" class="form-label" >Rating</label>
         <input type="range" min="1" max="5" name="review[rating]" id="rating" class="form-range">
      </div>
       -->
<div class="mb-3 mt-3">
    <label for="rating" class="form-label" >Rating</label>
<fieldset class="starability-slot">
  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>
</div>
      <div class="mb-3">
         <label for="comment" class="form-label">Comments</label>
         <textarea name="review[comment]" id="comment" cols="30" rows="10" class="form-control" required></textarea>
          <div  class="invalid-feedback">
           Please add some review
       </div>
      </div>
      <button class="btn btn-dark">Submit</button>
   </form>
   <% } else if (currUser) { %>
   <p class="review-status-message">You have already reviewed this listing.</p>
   <% } else { %>
   <p class="review-status-message">Please <a href="/login">log in</a> to leave a review.</p>
<% } %>
   
    <% if(listing.reviews.length > 0) {%>
   <div class="row">
   <h4>All Review</h4>
   <% for(review of listing.reviews) { %>
      
      <div class="card col-5 ms-3 mb-3 ">
         <div class="card-body">
            <h6 class="card-title"><%= review.author?.username || "Unknown User" %></h6>
             <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
            <p class="card-text"><%= review.comment %></p>   
         </div>
         <% if (currUser && review.author && review.author._id.equals(currUser._id)) { %>
            <form class="mb-3" method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=Delete">
               <button class="btn btn-dark mt-2" >Delete</button>
            </form>
         <% } %>
      </div>
   <%} %>
</div>
<% } %>
</div>
<div class="col-8 offset-2 mb-3">
   <h3>Location</h3>
   <div id="map"> </div>
</div>

</div>


<script src="/js/map.js"></script>
