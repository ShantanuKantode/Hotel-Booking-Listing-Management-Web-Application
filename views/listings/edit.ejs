<% layout("/layouts/boilerplate") %>
<body>
   <h2>Edit this page :</h2>
   <br>
   <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">         
      <div class="row">
      <div class="col">

      <div class="md-3 ">
      <label for="title" class="form-label">Title</label><br>
      <input name="listing[title]" class="form-control" value="<%= listing.title %>" type="text"  class="form-control" required>
      <div class="valid-feedback">Title Looks Good </div>
      <div class="invalid-feedback">Enter title</div>
      </div>
      <br>

      <div class="md-3">
      <label for="description" class="form-label">Description</label><br>
      <textarea name="listing[description]" class="form-control" required><%= listing.description  %>  </textarea>
      <div class="valid-feedback">Good description</div>
      <div class="invalid-feedback">Enter Short description</div>

      </div>
      
      <div class="mb-4 image-preview-section">
    <label class="form-label preview-label">Current Image</label>

    <div class="preview-card">
        <div class="preview-image-wrapper">
            <img 
                src="<%= orignalImageUrl %>" 
                alt="Current listing image"
                class="preview-image"
            >
        </div>

        <div class="preview-info">
            <div>
                <span class="preview-title">Listing Image</span>
                <span class="preview-subtitle">
                    This is the image currently displayed on your listing.
                </span>
            </div>
        </div>
    </div>
</div>

      <div class="md-3">
      <label class="form-label">Upload Image</label><br>
      <input name="listing[image]" class="form-control" value="<%= listing.image.url %>"image URL" type="file" required>
      <div class="invalid-feedback">URL of image</div>   
      </div>

      <br>

      <div class="row">
      <div class="md-3 col-md-4">
      <label class="form-label">Price</label><br>
      <input name="listing[price]"  class="form-control" value="<%= listing.price %>" type="number" required>
       <div class="valid-feedback"> </div>
      <div class="invalid-feedback">Price Should be Valid</div>
      </div>
      <br>

      <div class="md-3 col-md-8">
      <label class="form-label">Country</label><br>
      <input type="text" class="form-control" name="listing[country]"  value="<%= listing.country %>" required>
      <div class="valid-feedback"></div>
      <div class="invalid-feedback">Country Should be Valid</div>
      </div>

      
      <div class="md-3"></div>
      <label class="form-label">Location</label><br>
      <input name="listing[location]" class="form-control" value="<%= listing.location %>" type="text" required>
      <div class="valid-feedback"></div>
      <div class="invalid-feedback">Enter Location</div>
      </div>
      <br>

      <div class="mb-3">
      <label for="category" class="form-label">Category</label><br>
      <select id="category" name="listing[category]" class="form-select" required>
         <option value="Mountain" <%= listing.category === "Mountain" ? "selected" : "" %>>Mountain</option>
         <option value="Beach" <%= listing.category === "Beach" ? "selected" : "" %>>Beach</option>
         <option value="Lakefront" <%= listing.category === "Lakefront" ? "selected" : "" %>>Lakefront</option>
         <option value="Farms" <%= listing.category === "Farms" ? "selected" : "" %>>Farms</option>
         <option value="Amazing Pools" <%= listing.category === "Amazing Pools" ? "selected" : "" %>>Amazing Pools</option>
         <option value="Cabins" <%= listing.category === "Cabins" ? "selected" : "" %>>Cabins</option>
         <option value="Rooms" <%= listing.category === "Rooms" ? "selected" : "" %>>Rooms</option>
         <option value="Hotels" <%= listing.category === "Hotels" ? "selected" : "" %>>Hotels</option>
      </select>
      <div class="invalid-feedback">Please select a category.</div>
      </div>
      

      <button class="btn edit-btn md-3" >Edit </button>
      </div>
      </div>
   <br>
   </form>
</body>

