<% layout("/layouts/boilerplate") %>

<div class="row">
   <div class="col-8">   
   <h3>Create New Listing</h3>
   <br>
   <form method="POST" action="/listings" novalidate class="needs-validation mb-3" enctype="multipart/form-data" >
      <div class="mb-3">
       <label for="title" class="form-label">Title</label>
      <input name="listing[title]" placeholder="Title" type="text"  class="form-control" required/>
      <div class="valid-feedback">Title Looks Good </div>
      <div class="invalid-feedback">Enter title</div>
      </div>
    

      <div class="md-3">
      <label for="description" class="form-label">Description</label>
      <textarea name="listing[description]" placeholder="description" type="textarea" class="form-control" required></textarea>
      <div class="valid-feedback">Good description</div>
      <div class="invalid-feedback">Enter Short description</div>
      </div>
      

      

      <div class="md-3">
      <label for="image" class="form-label">Upload Image </label>
      <input name="listing[image]"  type="file" class="form-control" required/>
      <div class="invalid-feedback">URL of image</div>
      required
   </div>
      
      
      <div class="row">
      <div class="md-3 col-md-4" >
      <label for="price" class="form-label">Price </label>
      <input name="listing[price]"  placeholder="price" type="number" class="form-control" required/>
      <div class="valid-feedback"> </div>
      <div class="invalid-feedback">Price Should be Valid</div>
      </div>
      
       <div class="md-3 col-md-8">
      <label for="country" class="form-label">Country</label>
      <input type="text" name="listing[country]" placeholder="country" class="form-control" required/>
      <div class="valid-feedback"></div>
      <div class="invalid-feedback">Country Should be Valid</div>
       </div>
      
      </div>
      
      

       <div class="md-3">
      <label for="location" class="form-label">Location</label>
      <input name="listing[location]" placeholder="location" type="text" class="form-control" required/>
      <div class="valid-feedback"></div>
      <div class="invalid-feedback">Enter Location</div>
      </div>

      <div class="mb-3">
      <label for="category" class="form-label">Category</label>
      <select id="category" name="listing[category]" class="form-select" required>
         <option value="" selected disabled>Select a category</option>
         <option value="Mountain">Mountain</option>
         <option value="Beach">Beach</option>
         <option value="Lakefront">Lakefront</option>
         <option value="Farms">Farms</option>
         <option value="Amazing Pools">Amazing Pools</option>
         <option value="Cabins">Cabins</option>
         <option value="Rooms">Rooms</option>
         <option value="Hotels">Hotels</option>
      </select>
      <div class="invalid-feedback">Please select a category.</div>
      </div>
       
       <br/> <br/>

       <button class="btn add-btn  md-3" >Add</button>
   
   </form>
   </div>
   </div>

